<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    tools:context=".MainActivity">

    <ImageButton
        android:id="@+id/yesButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-200px"
        android:background="#00FFFFFF"
        android:clickable="true"
        android:contentDescription="@string/yes"
        android:contextClickable="true"
        android:focusable="true"
        android:onClick="sayYes"
        android:scaleType="fitCenter"
        android:scaleX="@dimen/material_emphasis_high_type"
        android:scaleY="@dimen/material_emphasis_high_type"
        android:soundEffectsEnabled="false"
        app:layout_constraintBottom_toTopOf="@+id/noButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"
        app:srcCompat="@drawable/yes" />

    <ImageButton
        android:id="@+id/noButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:background="#00FFFFFF"
        android:clickable="true"
        android:contentDescription="@string/no"
        android:contextClickable="true"
        android:focusable="true"
        android:onClick="sayNo"
        android:scaleType="fitCenter"
        android:scaleX="@dimen/material_emphasis_high_type"
        android:scaleY="@dimen/material_emphasis_high_type"
        android:soundEffectsEnabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/yesButton"
        app:srcCompat="@drawable/no" />

</androidx.constraintlayout.widget.ConstraintLayout>